# Large binary geometry buffer and PDFs are stored with Git LFS.
# Run `git lfs install` once before cloning or pushing.
assets/*.bin      filter=lfs diff=lfs merge=lfs -text
reference/*.pdf   filter=lfs diff=lfs merge=lfs -text
# Treat USD/glTF as binary (no line-ending munging, no bad diffs)
*.usd   binary
*.usdc  binary
*.gltf  -text
